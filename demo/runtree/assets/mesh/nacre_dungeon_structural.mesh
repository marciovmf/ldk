# Nacre dungeon structural quads (LDK native .mesh, v4.0 STATIC).
# Coordinate convention: +Y up; local origin (0,0,0) is CENTER OF BASE.
# Every mesh has identity node transform, with no scale or rotation.
# Place floor meshes at TILE CENTER. Place wall meshes at EDGE CENTER.
# 1 tile = 1 m; all walls are 1 m tall. 2m names refer to LENGTH.
# Wall X/Z orientation is baked into vertices; no transform rotation needed.
# Wall quads have two faces for correct rendering from either side.
# UV: 1m -> [0,1]; 2m -> [0,2] along wall length for texture repetition.
# Appearance (wall, door, portcullis, passage, cracked wall, cave wall,
# secret wall) is assigned by MATERIAL/TEXTURE, not a duplicate mesh.
# Pillars are low-poly 3D placeholder geometry; base is centered at Y=0.
# mesh_index layout:
#   0 nacre_floor_1m  X[-0.5,+0.5], Z[-0.5,+0.5], Y=0
#   1 nacre_wall_1m_x  X[-0.5,+0.5], Y[0,1], Z=0
#   2 nacre_wall_1m_z  X=0, Y[0,1], Z[-0.5,+0.5]
#   3 nacre_wall_2m_x  X[-1,+1], Y[0,1], Z=0
#   4 nacre_wall_2m_z  X=0, Y[0,1], Z[-1,+1]
#   5 nacre_pillar_intact   3D pillar, center of base at origin
#   6 nacre_pillar_broken   3D fractured pillar, center of base at origin

version 4.0
vertex_format STATIC
mesh_count 7
node_count 7

