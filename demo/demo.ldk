[.project]
project_name=demo
project_cmake_root=workspace
project_run_root=runtree
project_cmake_generator=Visual Studio 17 2022
project_build_config=RelWithDebInfo
project_cmake_arch=

[graphics]
resolution_width=1280
resolution_height=720
shadow_map_resolution=2048
shadow_distance=15

[general]
asset_root=assets
log_file=ldk.log
width=1024
height=768

[display]
title=My Awesome Game
width=1280
height=720
fullscreen=false
icon_path=assets/ldk.ico

[.editor]
play_current_scene=false
build_on_play=true

[.flags]
tag_0=Hero
tag_1=Vegetation
tag_2=Props
tag_3=tag_3
tag_4=tag_4
tag_5=tag_5
tag_6=tag_6
tag_7=tag_7
tag_8=tag_8
tag_9=tag_9
tag_10=tag_10
tag_11=tag_11
tag_12=tag_12
tag_13=tag_13
tag_14=tag_14
tag_15=tag_15

[scenes]
count=2
0.path=island_test.scene
0.name=island_test
1.path=base.scene
1.name=base

[.box]
dummy.box=assets/tftf_island.material|assets/ldk.ico

[.box_imports]
@package/ldk_prototype_textures.box=1
@package/ldk_particles.box=1
@package/ldk_skybox.box=1
