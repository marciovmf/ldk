# LDK UI theme format, version 1.
# Colors are packed 0xRRGGBBAA.
# ldk cyberpunk: sampled sage-gray surfaces and hot-pink accents.
# Reference screenshot: image(20261008-145906).png.
# Flat, square controls with approximately 1 px borders.
# Hover/pressed colors not visible in the reference are derived variants.
# General widget spacing is not exposed by the supplied theme schema.
ldk_editor_theme:
    version: 1
    base: "dark"
    theme_name: "LDK Cyberpunk"

    text: 0x202623FF
    text_disabled: 0x707C75FF

    window_bg: 0xB8C1BDFF
    panel_bg: 0xB5BEB9FF

    control_bg: 0xC3CBC6FF
    control_bg_hovered: 0xD0D8D2FF
    control_bg_active: 0xFF0054FF
    control_bg_active_hovered: 0xFF3476FF

    control_text: 0x202623FF
    control_text_hovered: 0x202623FF
    control_text_active: 0x202623FF
    control_text_active_hovered: 0x202623FF

    control_border: 0x949F98FF
    control_border_hovered: 0x707F76FF
    control_border_active: 0xFF0054FF
    control_border_active_hovered: 0xFF0054FF
    control_border_disabled: 0xA3ADA7FF

    border: 0xA6B1ABFF
    focus: 0xFF0054FF

    slider_track: 0x9BA7A0FF
    slider_track_hovered: 0x8D9992FF
    slider_track_active: 0x7E8D84FF
    slider_fill: 0xFF0054FF
    slider_thumb: 0xFF0054FF
    slider_thumb_hovered: 0xFF3476FF
    slider_thumb_active: 0xFF0054FF

    title: 0x202623FF
    title_bar: 0xB3BCB7FF
    title_bar_focused: 0xB6BFBAFF

    scrollbar_track: 0xB5BEB9FF
    scrollbar_thumb: 0x95A099FF
    scrollbar_thumb_hovered: 0x8D9992FF
    scrollbar_thumb_active: 0xFF0054FF

    tab_bar_bg: 0xB3BCB7FF
    separator: 0xA6B1ABFF

    tab_bg: 0xB3BCB7FF
    tab_bg_hovered: 0xC3CBC6FF
    tab_text: 0x404B44FF
    tab_text_hovered: 0x202623FF
    tab_border: 0xA6B1ABFF
    tab_border_hovered: 0x949F98FF

    tab_active_bg: 0xC2CBC5FF
    tab_active_text: 0x202623FF
    tab_active_border: 0xA6B1ABFF

    input_border: 0xA3ADA7FF
    input_bg: 0xC5CDC7FF
    input_bg_hovered: 0xD0D8D2FF
    input_bg_active: 0xC5CDC7FF
    input_bg_active_hovered: 0xD0D8D2FF

    control_border_size: 1.70000005
    input_border_size: 1.29999995
    window_border_size: 0.400000006
    window_interaction_border_size: 4
    slider_track_height: 0.119999997
    slider_thumb_width: 0.349999994
    text_cursor_blink_interval: 0.449999988
    text_cursor_width: 2
    text_cursor_padding_y: 4
    panel_padding: 4
    text_cursor_blink: true

    COLOR_TEXT: "${text}"
    COLOR_TEXT_DISABLED: "${text_disabled}"
    COLOR_WINDOW_BG: "${window_bg}"
    COLOR_PANEL_BG: "${panel_bg}"
    COLOR_CONTROL_BG: "${control_bg}"
    COLOR_CONTROL_BG_HOVERED: "${control_bg_hovered}"
    COLOR_CONTROL_BG_ACTIVE: "${control_bg_active}"
    COLOR_CONTROL_BG_ACTIVE_HOVERED: "${control_bg_active_hovered}"
    COLOR_CONTROL_TEXT: "${control_text}"
    COLOR_CONTROL_TEXT_HOVERED: "${control_text_hovered}"
    COLOR_CONTROL_TEXT_ACTIVE: "${control_text_active}"
    COLOR_CONTROL_TEXT_ACTIVE_HOVERED: "${control_text_active_hovered}"
    COLOR_CONTROL_TEXT_DISABLED: "${text_disabled}"
    COLOR_CONTROL_BORDER: "${control_border}"
    COLOR_CONTROL_BORDER_HOVERED: "${control_border_hovered}"
    COLOR_CONTROL_BORDER_ACTIVE: "${control_border_active}"
    COLOR_CONTROL_BORDER_ACTIVE_HOVERED: "${control_border_active_hovered}"
    COLOR_CONTROL_BORDER_DISABLED: "${control_border_disabled}"
    COLOR_BORDER: "${border}"
    COLOR_FOCUS: "${focus}"
    COLOR_SLIDER_TRACK: "${slider_track}"
    COLOR_SLIDER_TRACK_HOVERED: "${slider_track_hovered}"
    COLOR_SLIDER_TRACK_ACTIVE: "${slider_track_active}"
    COLOR_SLIDER_FILL: "${slider_fill}"
    COLOR_SLIDER_THUMB: "${slider_thumb}"
    COLOR_SLIDER_THUMB_HOVERED: "${slider_thumb_hovered}"
    COLOR_SLIDER_THUMB_ACTIVE: "${slider_thumb_active}"
    COLOR_TITLE: "${title}"
    COLOR_TITLE_BAR: "${title_bar}"
    COLOR_TITLE_BAR_FOCUSED: "${title_bar_focused}"
    COLOR_SCROLLBAR_TRACK: "${scrollbar_track}"
    COLOR_SCROLLBAR_THUMB: "${scrollbar_thumb}"
    COLOR_SCROLLBAR_THUMB_HOVERED: "${scrollbar_thumb_hovered}"
    COLOR_SCROLLBAR_THUMB_ACTIVE: "${scrollbar_thumb_active}"
    COLOR_TAB_BAR_BG: "${tab_bar_bg}"
    COLOR_TAB_BAR_SEPARATOR: "${separator}"
    COLOR_TAB_BG: "${tab_bg}"
    COLOR_TAB_BG_HOVERED: "${tab_bg_hovered}"
    COLOR_TAB_TEXT: "${tab_text}"
    COLOR_TAB_TEXT_HOVERED: "${tab_text_hovered}"
    COLOR_TAB_BORDER: "${tab_border}"
    COLOR_TAB_BORDER_HOVERED: "${tab_border_hovered}"
    COLOR_TAB_ACTIVE_BG: "${tab_active_bg}"
    COLOR_TAB_ACTIVE_TEXT: "${tab_active_text}"
    COLOR_TAB_ACTIVE_BORDER: "${tab_active_border}"
    COLOR_SEPARATOR: "${separator}"
    COLOR_INPUT_BORDER: "${input_border}"
    COLOR_INPUT_BG: "${input_bg}"
    COLOR_INPUT_BG_HOVERED: "${input_bg_hovered}"
    COLOR_INPUT_BG_ACTIVE: "${input_bg_active}"
    COLOR_INPUT_BG_ACTIVE_HOVERED: "${input_bg_active_hovered}"
